# Course materials: copyrighted textbook and the instructor's lecture slides.
# These must never be published.
/DTM 25-26 Summer

# Generated datasets. Each is hundreds of megabytes to over a gigabyte and is
# fully regenerable from the seed in src/config.py, so committing them would
# bloat the repository while adding nothing a reader cannot reproduce.
research/data/
*.csv.gz

# Safety copies written by invalidate.py before it removes superseded
# measurements. Useful locally while a fix is being validated, but they are
# stale by definition and would otherwise be mistaken for results.
*.prefix_bak

# Python bytecode
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# Local environment
.venv/
venv/
.env

# LaTeX build artifacts
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.lof
*.lot
*.out
*.run.xml
*.synctex.gz
*.toc

# LaTeX intermediate (paper)
paper/*.bbl
